# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PI_API_KEY: Required for official Pi Platform API server calls (/v2/payments/approve, /v2/payments/complete).
PI_API_KEY="YOUR_PI_PLATFORM_API_KEY"

# PI_SANDBOX_MODE: Set to "false" for Pi Mainnet production or "true" for Pi Sandbox testnet payments.
PI_SANDBOX_MODE="false"
VITE_PI_SANDBOX="false"
VITE_PI_ENV="mainnet"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLIGHT_API_PROVIDER: Flight GDS/NDC API Provider name (e.g. "duffel")
FLIGHT_API_PROVIDER=
# FLIGHT_API_BASE_URL: Base URL for external Flight Booking API (e.g. "https://api.duffel.com")
FLIGHT_API_BASE_URL=
# FLIGHT_API_ACCESS_TOKEN: Duffel API Access Token (duffel_test_... or duffel_live_...)
FLIGHT_API_ACCESS_TOKEN=

# VTU_API_BASE_URL: Official VTU.ng API v2 base endpoint (defaults to https://vtu.ng/wp-json)
VTU_API_BASE_URL="https://vtu.ng/wp-json"
# VTU_USERNAME: VTU.ng Portal Account Username for server-side JWT authentication
VTU_USERNAME=
# VTU_PASSWORD: VTU.ng Portal Account Password for server-side JWT authentication
VTU_PASSWORD=
# VTU_USER_PIN: Optional VTU.ng Portal Transaction PIN for webhook signature verification
VTU_USER_PIN=

# ADMIN_API_KEY: Optional server-to-server admin secret for privileged endpoints
ADMIN_API_KEY=

# PINOVA_DATA_DIR: Optional path for durable database JSON files (defaults to ./data/db)
PINOVA_DATA_DIR=
