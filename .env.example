# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PI_API_KEY: Required for official Pi Platform API server calls (/v2/payments/approve, /v2/payments/complete).
PI_API_KEY="YOUR_PI_PLATFORM_API_KEY"

# PI_SANDBOX_MODE: Set to "true" for Pi Sandbox testnet payments or "false" for Pi Mainnet payments.
PI_SANDBOX_MODE="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLIGHT_API_PROVIDER: Flight GDS/NDC API Provider name (e.g. "duffel")
FLIGHT_API_PROVIDER=
# FLIGHT_API_BASE_URL: Base URL for external Flight Booking API (e.g. "https://api.duffel.com")
FLIGHT_API_BASE_URL=
# FLIGHT_API_ACCESS_TOKEN: Duffel API Access Token (duffel_test_... or duffel_live_...)
FLIGHT_API_ACCESS_TOKEN=

# UTILITY_GATEWAY_API_URL: Optional external utility gateway API endpoint
UTILITY_GATEWAY_API_URL=
# UTILITY_GATEWAY_API_KEY: Optional bearer token for utility provider gateway
UTILITY_GATEWAY_API_KEY=

# ELECTRICITY_API_URL: Optional electricity distribution meter verification gateway
ELECTRICITY_API_URL=
# ELECTRICITY_API_KEY: Optional API key for electricity verification service
ELECTRICITY_API_KEY=

# ADMIN_API_KEY: Optional server-to-server admin secret for privileged endpoints
ADMIN_API_KEY=

# PINOVA_DATA_DIR: Optional path for durable database JSON files (defaults to ./data/db)
PINOVA_DATA_DIR=
